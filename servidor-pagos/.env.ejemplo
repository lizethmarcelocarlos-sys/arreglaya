# Copiá este archivo como .env (o mejor: corré  node configurar.js  que lo llena y lo prueba).
# El .env NUNCA se sube a GitHub ni se comparte: tiene la contraseña y la llave del banco.

# Dirección de la API del Banco Económico. Producción (plata real):
BANECO_URL=https://apimkt.baneco.com.bo/ApiGateway/
# Servidor de pruebas del banco:
# BANECO_URL=https://apimktdesa.baneco.com.bo/ApiGateway/

BANECO_USUARIO=
BANECO_CLAVE=
BANECO_LLAVE_AES=
BANECO_CUENTA=

# Modo prueba: cada QR sale por este monto en Bs, sin importar el precio de la oferta.
# Para cobrar el precio real de la oferta, poné 0.
MONTO_PRUEBA=1

# Minutos que vale un QR antes de anularlo
QR_VIDA_MINUTOS=10

# Puerto del servidor (la app se compila con PAGOS_URL=http://IP-DE-ESTA-PC:3100)
PUERTO=3100

# Si al registrar la URL de aviso en el banco pusiste un token, ponelo acá:
# BANECO_AVISO_TOKEN=

# Proyecto de Supabase (por defecto el de ArreglaYa; la clave es la PUBLICABLE, nunca la service_role)
# SUPABASE_URL=https://prdzxcybmcxprzjsovuy.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
